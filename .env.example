# Run: yarn setup
# That writes a minimal .env with the backend URL and push registration enabled.
# Add EXPO_PUBLIC_SKIP_PUSH_REGISTRATION=true only when push delivery is intentionally disabled.
#
# Optional dev overrides: copy .env.development.local.example → .env.development.local
# Full guide: docs/GETTING_STARTED.md

# Wallet backend URL. Development default: http://localhost:4000; physical devices should use the PC LAN IP.
# Production/release builds require an explicit HTTPS URL and reject loopback hosts.
# EXPO_PUBLIC_WALLET_API_BASE_URL=http://<windows-lan-ip>:4000

# Wallet Backend TLS public-key pins for non-development native builds (ADR 0005).
# Comma-separated SHA-256 SPKI hashes with the sha256/ prefix (no bundled .cer files).
# Example: EXPO_PUBLIC_WALLET_API_PINNED_CERTS=sha256/Y5HqyCJlL1uzfx/hodI3CK4zcMJV5WdNdhS7Kmw6sA4=
# EXPO_PUBLIC_WALLET_API_PINNED_CERTS=

# Screen capture prevention on Wallet Home, Credential Detail, Scan, and History.
# Set to true to allow tester screenshots on sensitive screens. Default: guard active.
# EXPO_PUBLIC_DISABLE_SCREEN_CAPTURE_GUARD=true

# OID4VP issuer relying-party trust entry for PID auth requests.
# Client ID is normalized to decentralized_identifier:<did> when the prefix is omitted.
# EXPO_PUBLIC_ISSUER_OID4VP_DID_WEB_CLIENT_ID=did:web:issuer.example.com
# EXPO_PUBLIC_ISSUER_OID4VP_DID_WEB_RESPONSE_ORIGIN=https://issuer.example.com
# EXPO_PUBLIC_ISSUER_OID4VP_DID_WEB_NAME=PID Issuer
# EXPO_PUBLIC_ISSUER_OID4VP_DID_WEB_JWK={"kty":"OKP","crv":"Ed25519","x":"..."}

# Staging/preview only: trust redirect_uri Verifier API client_id outside __DEV__ when the base URL is HTTPS.
# Production customer releases should use EXPO_PUBLIC_VERIFIER_DID_WEB_* instead and leave this unset/false.
# EXPO_PUBLIC_ALLOW_REDIRECT_URI_VERIFIER_TRUST=true
# EXPO_PUBLIC_VERIFIER_API_BASE_URL=https://verifier.example.com:455
# EXPO_PUBLIC_VERIFIER_NAME=Verifier API
# Relative JWKS path on the Verifier origin (from response_uri) for signed redirect_uri JARs (default /openid4vc/jwks).
# EXPO_PUBLIC_VERIFIER_JWKS_PATH=/openid4vc/jwks
# Verifier JWKS fetch timeout in ms (default 15000).
# EXPO_PUBLIC_VERIFIER_JWKS_FETCH_TIMEOUT_MS=15000
# Max Verifier JWKS response body size in UTF-8 bytes (default 65536).
# EXPO_PUBLIC_VERIFIER_JWKS_MAX_BYTES=65536
# Optional Verifier compatibility settings for single-credential DCQL requests,
# applied to preview/release bundles when explicitly set. Dual-format requests
# always use their per-credential query-id envelope.
# `raw` submits a compact SD-JWT directly; `object_array` / `object_string` use DCQL query-id envelopes.
# `response_uri` puts that exact URI in the SD-JWT KB-JWT `aud`; default is `client_id`.
# EXPO_PUBLIC_VERIFIER_DCQL_VP_TOKEN_SHAPE=raw
# EXPO_PUBLIC_VERIFIER_KB_AUD=response_uri

# Build-time OID4VP adapter toggle (requires rebuild). Default false.
# true = use @openid4vc/openid4vp for in-scope Scan/same-device DCQL direct_post parse+submit.
# EXPO_PUBLIC_OID4VC_VP_ADAPTER=false

# Production OID4VP Verifier trust (release builds). Required instead of EXPO_PUBLIC_VERIFIER_API_BASE_URL.
# EXPO_PUBLIC_VERIFIER_DID_WEB_CLIENT_ID=did:web:verifier.example.com
# EXPO_PUBLIC_VERIFIER_DID_WEB_RESPONSE_ORIGIN=https://verifier.example.com
# EXPO_PUBLIC_VERIFIER_DID_WEB_NAME=Trusted Verifier
# EXPO_PUBLIC_VERIFIER_DID_WEB_JWK={"kty":"OKP","crv":"Ed25519","x":"..."}
# When the Verifier uses bare did:key client_id (signed JAR), pin it here.
# Response origin defaults to EXPO_PUBLIC_VERIFIER_API_BASE_URL origin when unset.
# EXPO_PUBLIC_VERIFIER_DID_KEY_CLIENT_ID=did:key:zDnae...
# EXPO_PUBLIC_VERIFIER_DID_KEY_RESPONSE_ORIGIN=https://verifier.example.com:455
# EXPO_PUBLIC_VERIFIER_DID_KEY_NAME=Trusted Verifier

# OID4VP did:web DID document fetch policy.
# Timeout in ms before aborting did.json fetch (default 15000).
# EXPO_PUBLIC_DID_WEB_FETCH_TIMEOUT_MS=15000
# Max did.json response body size in UTF-8 bytes before JSON parse (default 65536).
# EXPO_PUBLIC_DID_WEB_MAX_BYTES=65536

# Same-device issuance — Issuer web login portal (Wallet Home ขอเอกสาร).
# Login URL opened with ReturnUrl + documentType query params; Issuer redirects to walletapp callback.
# EXPO_PUBLIC_ISSUER_LOGIN_URL=https://issuer.zenithcomp.co.th:455/Account/Login
# Wallet callback registered with Issuer (default walletapp://callback).
# EXPO_PUBLIC_ISSUER_WALLET_RETURN_URL=walletapp://callback
# OAuth client_id for authorization_code token exchange (default placeholder until Issuer registers).
# EXPO_PUBLIC_ISSUER_OAUTH_CLIENT_ID=s6BhdRkqt3
# Credential issuer base URL for metadata/token (default https://issuer.zenithcomp.co.th:455).
# EXPO_PUBLIC_ISSUER_CREDENTIAL_ISSUER=https://issuer.zenithcomp.co.th:455
# Token endpoint override (default https://issuer.zenithcomp.co.th:455/token).
# EXPO_PUBLIC_ISSUER_TOKEN_URL=https://issuer.zenithcomp.co.th:455/token
# When true, Wallet Home ขอเอกสาร opens lib-built OAuth /authorize URL (PKCE) instead of portal offer-URI login.
# EXPO_PUBLIC_SAME_DEVICE_AUTH_CODE_ISSUANCE=false

# OID4VCI DPoP on token/credential endpoints (session-scoped P-256 key; no extra biometric).
# Unit: boolean. Default: false (disabled). Zenithcomp issuer requires this OFF.
# Only `true` or `1` enables DPoP. Values like `false` or an empty string keep it disabled.
# After changing any EXPO_PUBLIC_* value: restart Metro with `yarn start --reset-cache`
# and request a fresh portal issuance link (pre-auth codes are single-use).
# EXPO_PUBLIC_OID4VC_DPOP_ENABLED=true

# Per-credential signing (`k_cred`) is on by default for OID4VCI PoP / bind / presentation.
# Unit: boolean. Default: true (unset = on). Set false or 0 to fall back to the wallet-level key.
# EXPO_PUBLIC_PER_CREDENTIAL_SIGNING_ENABLED=true

# Attach cached WUA/WIA wallet attestations to POST /credential (OID4VCI credential request body).
# Unit: boolean. Default: false (disabled). Zenithcomp /credential accepts only credential_configuration_id + proofs.jwt.
# Only `true` or `1` enables attestation fields. Leave unset for zenithcomp.
# EXPO_PUBLIC_OID4VC_CREDENTIAL_WALLET_ATTESTATIONS_ENABLED=true

# v2 crypto — orphan issuance pending keys older than this TTL are garbage-collected.
# Unit: ms. Default: 1800000 (30 min).
# EXPO_PUBLIC_ISSUANCE_PENDING_KEY_TTL_MS=1800000

# Wallet Provider WUA/WIA attestations (local server mock: unsigned alg: none; not a production WP).
# Unit: URL. Default in __DEV__: http://localhost:4000
# Never point a production EXPO_PUBLIC_WALLET_PROVIDER_BASE_URL at this mock.
# Peer WPs without POST /wallet-api/wallet-attestations/challenge return 404; the wallet skips
# hardware k_attest activation unless WUA is requested on the credential request.
# EXPO_PUBLIC_WALLET_PROVIDER_BASE_URL=http://localhost:4000

# How long to skip hardware k_attest challenge POSTs after a peer WP 404 (route missing).
# Unit: ms. Default: 3600000 (1 hour).
# EXPO_PUBLIC_WALLET_ATTEST_CHALLENGE_UNSUPPORTED_TTL_MS=3600000

# Wallet Provider challenge and attest POST timeout.
# Unit: ms. Default: 15000 (15 seconds). Abort maps to WalletAttestChallengeFailed: timeout
# or WalletAttestRequestFailed: timeout.
# EXPO_PUBLIC_WALLET_ATTEST_FETCH_TIMEOUT_MS=15000

# Hardware P-256 / ES256 holder signing (Android StrongBox-first). Requires rebuild.
# Unit: boolean. Default: true. Set false / 0 / FALSE to use Keychain Ed25519 k_cred.
EXPO_PUBLIC_HARDWARE_P256_SIGNING_ENABLED=true

# Dev-only Knox Vault / StrongBox KeyMint startup probe when P-256 signing is enabled.
# Unit: boolean. Default: true in dev (runs once per app session on Android). Set false to skip.
# EXPO_PUBLIC_RUN_STRONGBOX_PROBE_ON_STARTUP=true

# Native hardware ECDSA backend when P-256 signing is enabled (Android only).
# Unit: enum. Default: custom. Release builds refuse mock and animo (HardwareEcdsaBackendNotAllowed).
# Values: custom | animo | mock (animo/mock are __DEV__ experiments only).
EXPO_PUBLIC_HARDWARE_ECDSA_BACKEND=custom

# Slice B capacity-stress probe max createKey attempts (dev checklist runner only).
# Unit: count. Default: 48. Effect: row 4 stops after N keys or first Keystore failure.
# EXPO_PUBLIC_HARDWARE_ECDSA_CAPACITY_PROBE_LIMIT=48

# Action-scoped hardware signing session TTL aligned with Android auth validity window.
# Unit: ms. Default: 30000 (30 s). mdoc sessions use max(this, EXPO_PUBLIC_HCE_ARM_WINDOW_MS)
# so a tap inside the HCE arm window is not rejected as session-expired.
# EXPO_PUBLIC_HARDWARE_SIGNING_SESSION_TTL_MS=30000

# VP/offer dismiss redelivery grace: ignore the same deeplink this long after Back
# so Android intent redelivery does not reopen the flow. After this window, the same
# URI may open again (intentional re-tap). Unit: ms. Default: 1500.
# EXPO_PUBLIC_DEEPLINK_DISMISS_REDELIVERY_GRACE_MS=1500

# Max signatures per action-scoped session by purpose (oid4vci / oid4vp / mdoc / attest).
# Unit: count. Defaults: oid4vci=8, oid4vp=4, mdoc=16, attest=2.
# EXPO_PUBLIC_HARDWARE_SIGNING_MAX_SIGS_OID4VCI=8
# EXPO_PUBLIC_HARDWARE_SIGNING_MAX_SIGS_OID4VP=4
# EXPO_PUBLIC_HARDWARE_SIGNING_MAX_SIGS_MDOC=16
# EXPO_PUBLIC_HARDWARE_SIGNING_MAX_SIGS_ATTEST=2

# My QR — Wallet Broker (engagement QR + deposited OID4VP request).
# Development default: the configured Broker service over HTTPS.
# Production/release builds require an explicit HTTPS URL and reject missing or loopback values.
# EXPO_PUBLIC_BROKER_BASE_URL=https://broker.example
