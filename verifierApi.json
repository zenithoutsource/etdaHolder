{
  "openapi": "3.0.1",
  "info": {
    "title": "VerifierAPI",
    "version": "1.0"
  },
  "paths": {
    "/Account/ThaIDSignIn": {
      "get": {
        "tags": [
          "Account"
        ],
        "parameters": [
          {
            "name": "pid",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ReturnUrl",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/thaiid/login": {
      "get": {
        "tags": [
          "Account"
        ],
        "parameters": [
          {
            "name": "returnUrl",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "documentType",
            "in": "query",
            "schema": {
              "enum": [
                "Transcript",
                "IDCard",
                "DriverLicense",
                "Bootcamp"
              ],
              "type": "string"
            }
          },
          {
            "name": "error",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/VerifyScanQR": {
      "get": {
        "tags": [
          "PresentResult"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/generate-vp-qr": {
      "post": {
        "tags": [
          "Verifier"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateVpQrRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateVpQrRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateVpQrRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/openid4vc/request/{id}": {
      "get": {
        "tags": [
          "Verifier"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/openid4vc/verify/{id}": {
      "post": {
        "tags": [
          "Verifier"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "vp_token": {
                    "type": "string"
                  },
                  "state": {
                    "type": "string"
                  },
                  "error": {
                    "type": "string"
                  },
                  "error_description": {
                    "type": "string"
                  },
                  "error_uri": {
                    "type": "string"
                  }
                }
              },
              "encoding": {
                "vp_token": {
                  "style": "form"
                },
                "state": {
                  "style": "form"
                },
                "error": {
                  "style": "form"
                },
                "error_description": {
                  "style": "form"
                },
                "error_uri": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/openid4vc/vp/{id}": {
      "get": {
        "tags": [
          "Verifier"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/verifier/scan": {
      "post": {
        "tags": [
          "VerifierScan"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScanRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ScanRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ScanRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/verifier/status/{sessionId}": {
      "get": {
        "tags": [
          "VerifierScan"
        ],
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GenerateVpQrRequest": {
        "type": "object",
        "properties": {
          "document_type": {
            "enum": [
              "Transcript",
              "IDCard",
              "DriverLicense",
              "Bootcamp"
            ],
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ScanRequest": {
        "type": "object",
        "properties": {
          "scanned_value": {
            "type": "string",
            "nullable": true
          },
          "doc_type": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}
