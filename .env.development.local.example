# Optional development overrides — copy to .env.development.local (gitignored).
# NOT required for first run. See docs/GETTING_STARTED.md.

# Development-only wallet operation logs. Defaults to enabled in __DEV__ when unset.
# Set to false to mute [wallet:*] logs. Production builds ignore this flag and stay off.
EXPO_PUBLIC_ENABLE_WALLET_DEBUG_LOGS=true

# Allow tester screenshots on sensitive screens (disables FLAG_SECURE while focused).
# EXPO_PUBLIC_DISABLE_SCREEN_CAPTURE_GUARD=true

# Comma-separated Wallet Backend public-key pins for native HTTPS pinning (ADR 0005).
# Format: sha256/<base64 SPKI hash> — not bundled .cer resource names.
# Preview/release builds require at least one pin when EXPO_PUBLIC_WALLET_API_BASE_URL is HTTPS.
# Example for wallet.zenithcomp.co.th:455:
# EXPO_PUBLIC_WALLET_API_PINNED_CERTS=sha256/Y5HqyCJlL1uzfx/hodI3CK4zcMJV5WdNdhS7Kmw6sA4=
EXPO_PUBLIC_WALLET_API_PINNED_CERTS=

# OID4VP Verifier API used by Scan for presentation testing.
# Example: https://verifier.zenithcomp.co.th:455
EXPO_PUBLIC_VERIFIER_API_BASE_URL=
EXPO_PUBLIC_VERIFIER_NAME=Verifier API

# OID4VC VP adapter (build-time). Set true only for Hermes re-E2E on device; see docs/GETTING_STARTED.md § VP adapter re-E2E.
# EXPO_PUBLIC_OID4VC_VP_ADAPTER=true

# Testing-period interop: trust unlisted HTTPS OID4VCI issuers and OID4VP verifiers.
# Unit: boolean. Default: false. Only the string true enables each flag.
# EXPO_PUBLIC_TRUST_ANY_OID4VC_PEER=true — enables both issuer and verifier below.
# EXPO_PUBLIC_TRUST_ANY_OID4VC_ISSUER=true — OID4VCI claim skips PID-first gate; allowlisted Issuer OID4VP peers.
# EXPO_PUBLIC_TRUST_ANY_OID4VC_VERIFIER=true — unlisted HTTPS OID4VP verifiers when client_id/response_uri share origin.
# Leave unset/false for customer production builds. Crypto gates (ES256/EdDSA, holder binding, backend pinning) stay fail-closed.
EXPO_PUBLIC_TRUST_ANY_OID4VC_PEER=true

# Demo interop profile (development opt-in). EAS injects the build profile; non-development opt-in is preview-only.
EXPO_PUBLIC_WALLET_DEMO_INTEROP=true

# Optional production-style did:web verifier trust entry (hardware-free local testing).
# Client ID is normalized to decentralized_identifier:<did> when the prefix is omitted.
# EXPO_PUBLIC_VERIFIER_DID_WEB_CLIENT_ID=did:web:verifier.example.com
# EXPO_PUBLIC_VERIFIER_DID_WEB_RESPONSE_ORIGIN=https://verifier.example.com
# EXPO_PUBLIC_VERIFIER_DID_WEB_NAME=Trusted Verifier
# EXPO_PUBLIC_VERIFIER_DID_WEB_JWK={"kty":"OKP","crv":"Ed25519","x":"..."}

# Optional did:web issuer OID4VP relying-party trust entry for PID auth requests (P2 steps 4–7).
# Required before E2E when the customer Issuer sends openid4vp Authorization Requests.
# Example host: https://issuer.zenithcomp.co.th:455 — set client_id and response_uri origin to match the live Issuer.
# Client ID is normalized to decentralized_identifier:<did> when the prefix is omitted.
# Encode the port separator in did:web as %3A (did:web:host%3Aport).
# EXPO_PUBLIC_ISSUER_OID4VP_DID_WEB_CLIENT_ID=did:web:issuer.zenithcomp.co.th%3A455
# EXPO_PUBLIC_ISSUER_OID4VP_DID_WEB_RESPONSE_ORIGIN=https://issuer.zenithcomp.co.th:455
# EXPO_PUBLIC_ISSUER_OID4VP_DID_WEB_NAME=PID Issuer
# EXPO_PUBLIC_ISSUER_OID4VP_DID_WEB_JWK={"kty":"OKP","crv":"Ed25519","x":"..."}

# NEVER enable for release builds — development-only Verifier compatibility.
EXPO_PUBLIC_DISABLE_SD_JWT_KB_FOR_TESTING=

# Wallet key TTL. Dev is ms (short values for testing), prod is days.
# Same vars gate per-credential hardware k_cred TTL (P3 renewal-required) when the document is still valid.
# Omit to use defaults (dev=300000ms i.e. 5min, prod=180 days).
EXPO_PUBLIC_WALLET_KEY_DEV_TTL_MS=300000
EXPO_PUBLIC_WALLET_KEY_PROD_TTL_DAYS=180

# App-lock PIN session grace (milliseconds). Default 300000ms (5 minutes).
# Counts continuous background idle only — foreground use does not consume the window.
EXPO_PUBLIC_WALLET_PIN_SESSION_GRACE_MS=300000

# Development-only OID4VP Verifier compatibility probes.
# EXPO_PUBLIC_VERIFIER_DCQL_VP_TOKEN_SHAPE=object_array
EXPO_PUBLIC_VERIFIER_DCQL_VP_TOKEN_SHAPE=
# EXPO_PUBLIC_VERIFIER_KB_AUD=client_id
EXPO_PUBLIC_VERIFIER_KB_AUD=

# Days before document expiry warnings. Default 30 when unset.
EXPO_PUBLIC_DOCUMENT_EXPIRY_WARNING_WINDOW_DAYS=30

# Issuer web login for Wallet Home "ขอเอกสาร" (overrides sameDeviceIssuance defaults).
# EXPO_PUBLIC_ISSUER_LOGIN_URL=https://issuer.zenithcomp.co.th:455/Account/Login
# EXPO_PUBLIC_ISSUER_WALLET_RETURN_URL=walletapp://callback

# Dual-format issuance / NFC policy
EXPO_PUBLIC_DUAL_FORMAT_ISSUE_SKEW_MS=300000
EXPO_PUBLIC_HCE_ARM_WINDOW_MS=180000
EXPO_PUBLIC_NFC_PAYLOAD_MAX_BYTES=65536

# Remote OID4VP presentation-definition fetch policy
# Timeout in ms before aborting PD fetch (default 15000).
EXPO_PUBLIC_PRESENTATION_DEFINITION_FETCH_TIMEOUT_MS=15000
# Max PD response body size in bytes (default 65536).
EXPO_PUBLIC_PRESENTATION_DEFINITION_MAX_BYTES=65536

# OID4VP did:web DID document fetch policy
# Timeout in ms before aborting did.json fetch (default 15000).
EXPO_PUBLIC_DID_WEB_FETCH_TIMEOUT_MS=15000
# Max did.json response body size in UTF-8 bytes before JSON parse (default 65536).
EXPO_PUBLIC_DID_WEB_MAX_BYTES=65536

# Wallet history retention in days; 0 keeps all events (default).
EXPO_PUBLIC_WALLET_HISTORY_RETENTION_DAYS=0

# Hardware P-256 / ES256 holder signing. Default on; custom AndroidKeyStore backend.
EXPO_PUBLIC_HARDWARE_P256_SIGNING_ENABLED=true
EXPO_PUBLIC_HARDWARE_ECDSA_BACKEND=custom
